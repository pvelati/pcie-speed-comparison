{
  "name": "bandwidth-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PCIe Speed Explorer — interactive comparison of PCIe generations and lane widths against USB, HDMI, Ethernet and Wi-Fi.",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=${BASE_PATH:-/}",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^14.0.0",
    "puppeteer-core": "^24.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
