{
  "ci": {
    "collect": {
      "numberOfRuns": 2,
      "url": ["http://localhost:4173/"],
      "startServerCommand": "node node_modules/vite/bin/vite.js preview --port 4173 --strictPort --base=${BASE_PATH:-/}",
      "startServerReadyPattern": "Local:",
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new --disable-gpu --disable-dev-shm-usage",
        "screenWidth": 1350,
        "screenHeight": 900,
        "maxWaitForLoad": 30000
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    }
  }
}
